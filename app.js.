const connection = new solanaWeb3.Connection(
  "https://api.devnet.solana.com",
  "confirmed"
);

const connectButton = document.getElementById("connect");
const scanButton = document.getElementById("scan");

const statusText = document.getElementById("status");
const scanResult = document.getElementById("scanResult");

let walletAddress = null;

connectButton.addEventListener("click", async () => {
  try {
    const provider =
      window.phantom?.solana || window.solana;

    if (!provider?.isPhantom) {
      statusText.textContent =
        "Open this website in Phantom's browser.";
      return;
    }

    const response = await provider.connect();

    walletAddress = response.publicKey.toString();

    statusText.textContent =
      "Connected: " + walletAddress;
  } catch (error) {
    statusText.textContent = error.message;
  }
});

scanButton.addEventListener("click", async () => {
  if (!walletAddress) {
    scanResult.textContent = "Connect wallet first.";
    return;
  }

  try {
    scanResult.textContent = "Scanning Devnet...";

    const publicKey = new solanaWeb3.PublicKey(walletAddress);

    const balance = await connection.getBalance(publicKey);

    const accounts =
      await connection.getParsedTokenAccountsByOwner(
        publicKey,
        {
          programId: new solanaWeb3.PublicKey(
            "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
          )
        }
      );

    const findings = scanTokenAccounts(accounts.value);

    scanResult.textContent =
      `SOL balance: ${balance / solanaWeb3.LAMPORTS_PER_SOL}
      | Token accounts: ${accounts.value.length}
      | Active delegates: ${findings.length}`;

    console.log("Security findings:", findings);

  } catch (error) {
    scanResult.textContent = "Scan failed: " + error.message;
  }
});