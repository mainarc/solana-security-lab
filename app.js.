const connection = new solanaWeb3.Connection(
  "https://api.devnet.solana.com",
  "confirmed"
);

const connectButton = document.getElementById("connect");
const scanButton = document.getElementById("scan");

const statusText = document.getElementById("status");
const scanResult = document.getElementById("scanResult");

let walletAddress = null;

connectButton.addEventListener("click", async () => {
  try {
    if (!window.phantom?.solana) {
      statusText.textContent = "Open this site in Phantom's browser.";
      return;
    }

    const response = await window.phantom.solana.connect();

    walletAddress = response.publicKey.toString();

    statusText.textContent = "Connected: " + walletAddress;
  } catch (error) {
    statusText.textContent = "Connection cancelled.";
  }
});

scanButton.addEventListener("click", async () => {
  if (!walletAddress) {
    scanResult.textContent = "Connect your wallet first.";
    return;
  }

  scanResult.textContent = "Wallet connected. Preparing security scan...";

  console.log("Wallet ready for inspection:", walletAddress);
});